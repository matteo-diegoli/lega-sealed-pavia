---
// Un tavolo: i due giocatori uno di fronte all'altro, con il risultato in mezzo (o "da giocare").
import type { Partita } from '../lib/dati/schema.ts';
import { testoRisultato, vincitore } from '../lib/lega/match.ts';
import { linkGiocatore } from '../lib/sito/percorso.ts';

interface Props {
	partita: Partita;
	tavolo: number;
	/** Nome da mostrare per ogni identificativo. */
	nomi: Map<string, string>;
	/** Bordo dorato della finale. */
	finale?: boolean;
}
const { partita, tavolo, nomi, finale = false } = Astro.props;
const esito = vincitore(partita);
const risultato = testoRisultato(partita);
const [a, b] = partita.giocatori;
const stato = (lato: 0 | 1) => (esito === lato ? 'vince' : typeof esito === 'number' ? 'perde' : null);
---

<li class:list={['scheda', 'partita', { finale }]}>
	<span class="tavolo"><span class="solo-lettori">Tavolo </span><span aria-hidden="true">T</span>{tavolo}</span>
	<span class:list={['giocatore', stato(0)]}>
		<a href={linkGiocatore(a)}>{nomi.get(a) ?? a}</a>{esito === 0 && <span class="solo-lettori"> (vince)</span>}
	</span>
	<span class:list={['risultato', { 'da-giocare': !risultato }]}>
		{risultato ?? 'vs'}
		{!risultato && <span class="solo-lettori"> (da giocare)</span>}
		{esito === 'pareggio' && <span class="solo-lettori"> (pareggio)</span>}
	</span>
	<span class:list={['giocatore', 'destra', stato(1)]}>
		<a href={linkGiocatore(b)}>{nomi.get(b) ?? b}</a>{esito === 1 && <span class="solo-lettori"> (vince)</span>}
	</span>
</li>

<style>
	.partita {
		display: grid;
		grid-template-columns: auto 1fr auto 1fr;
		align-items: center;
		gap: 0.75rem;
	}
	.partita.finale {
		border-color: transparent;
		background:
			linear-gradient(var(--superficie), var(--superficie)) padding-box,
			linear-gradient(120deg, var(--oro), #b8862b 40%, var(--accento)) border-box;
	}
	.tavolo {
		font-size: 0.7rem;
		font-weight: 700;
		color: var(--testo-tenue);
		background: var(--superficie-alta);
		padding: 0.15rem 0.4rem;
		border-radius: 4px;
	}
	.giocatore {
		font-weight: 600;
		min-width: 0;
		overflow-wrap: anywhere;
	}
	.giocatore a {
		color: inherit;
		text-decoration: none;
	}
	.giocatore a:hover {
		text-decoration: underline;
	}
	.destra {
		text-align: right;
	}
	.vince {
		color: var(--vittoria);
	}
	.perde {
		color: var(--testo-tenue);
		font-weight: 400;
	}
	.risultato {
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		font-size: 1.1rem;
		text-align: center;
	}
	.risultato.da-giocare {
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--testo-tenue);
	}
</style>
