---
// Emblema della lega: una carta da gioco con dentro una torre di Pavia.
// Disegno originale; servirà anche come base per l'icona dell'app (Fase 6).

interface Props {
	/** Lato in pixel. */
	dimensione?: number;
	class?: string;
}
const { dimensione = 32, class: classe } = Astro.props;
const id = `emblema-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
	class:list={['emblema', classe]}
	width={dimensione}
	height={dimensione}
	viewBox="0 0 64 64"
	aria-hidden="true"
	focusable="false"
>
	<defs>
		<linearGradient id={id} x1="0" x2="1" y1="0" y2="1">
			<stop offset="0" style="stop-color: var(--accento)" />
			<stop offset="1" style="stop-color: var(--accento-2)" />
		</linearGradient>
	</defs>
	<!-- Carta, leggermente inclinata -->
	<rect x="14" y="5" width="36" height="54" rx="5" transform="rotate(-8 32 32)" fill="var(--superficie)" stroke={`url(#${id})`} stroke-width="3" />
	<!-- Torre merlata -->
	<path
		d="M24 50 V19 h3 v4 h3 v-4 h3 v4 h3 v-4 h3 V50 Z M30 29 v7 h3 v-7 Z M29 50 v-6 a2.5 2.5 0 0 1 5 0 v6 Z"
		fill={`url(#${id})`}
		fill-rule="evenodd"
		transform="rotate(-8 32 32)"
	/>
</svg>
