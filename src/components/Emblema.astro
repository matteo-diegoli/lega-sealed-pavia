---
// Emblema della lega: una carta da gioco con dentro una torre di Pavia.
// Disegno originale (forma in src/lib/sito/emblema.ts, la stessa delle icone dell'app).
import { CARTA, ROTAZIONE, TORRE } from '../lib/sito/emblema.ts';

interface Props {
	/** Lato in pixel. */
	dimensione?: number;
	class?: string;
}
const { dimensione = 32, class: classe } = Astro.props;
const id = `emblema-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
	class:list={['emblema', classe]}
	width={dimensione}
	height={dimensione}
	viewBox="0 0 64 64"
	aria-hidden="true"
	focusable="false"
>
	<defs>
		<linearGradient id={id} x1="0" x2="1" y1="0" y2="1">
			<stop offset="0" style="stop-color: var(--accento)" />
			<stop offset="1" style="stop-color: var(--accento-2)" />
		</linearGradient>
	</defs>
	<!-- Carta, leggermente inclinata -->
	<rect
		x={CARTA.x}
		y={CARTA.y}
		width={CARTA.larghezza}
		height={CARTA.altezza}
		rx={CARTA.raggio}
		transform={ROTAZIONE}
		fill="var(--superficie)"
		stroke={`url(#${id})`}
		stroke-width="3"
	/>
	<!-- Torre merlata -->
	<path d={TORRE} fill={`url(#${id})`} fill-rule="evenodd" transform={ROTAZIONE} />
</svg>
