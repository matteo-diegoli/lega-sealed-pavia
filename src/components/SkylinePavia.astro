---
// Skyline di Pavia disegnato a linee luminose (forma in src/lib/sito/skyline.ts).
// Decorativo: nascosto ai lettori di schermo.
import { SKYLINE } from '../lib/sito/skyline.ts';

interface Props {
	class?: string;
}
const { class: classe } = Astro.props;

// Identificativo unico per la sfumatura (più skyline nella stessa pagina non si disturbano).
const id = `skyline-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
	class:list={['skyline', classe]}
	viewBox="0 0 1200 240"
	preserveAspectRatio="xMidYMax slice"
	aria-hidden="true"
	focusable="false"
>
	<defs>
		<linearGradient id={id} x1="0" x2="1" y1="0" y2="0">
			<stop offset="0" style="stop-color: var(--accento)" />
			<stop offset="1" style="stop-color: var(--accento-2)" />
		</linearGradient>
	</defs>
	<g fill="none" stroke={`url(#${id})`} stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round">
		<path class="riempito" d={SKYLINE.edifici} />
		<path d={SKYLINE.terreno} />
		<path class="riempito" d={SKYLINE.ponte} />
		<path d={SKYLINE.colonnine} stroke-width="1.5" />
		<path class="fiume" d={SKYLINE.fiume} stroke-width="1.5" />
	</g>
</svg>

<style>
	.skyline {
		display: block;
		width: 100%;
		height: auto;
		filter: drop-shadow(var(--bagliore));
	}
	.riempito {
		fill: var(--superficie);
		fill-opacity: 0.6;
	}
	.fiume {
		opacity: 0.6;
	}
</style>
