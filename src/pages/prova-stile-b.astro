---
// TEMPORANEO (Fase 3): direzione di stile B, "Arena".
import { datiProvaStile } from '../lib/prova-stile.ts';

const d = datiProvaStile();
const nomiRarita = { mythic: 'Mitica', rare: 'Rara', uncommon: 'Non comune', common: 'Comune', special: 'Speciale', bonus: 'Bonus' };
const nomiColori: Record<string, string> = { W: 'bianco', U: 'blu', B: 'nero', R: 'rosso', G: 'verde' };
const puntiMassimi = Math.max(1, ...d.righe.map((r) => r.punti));
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Stile B – Arena · {d.nomeLega}</title>
	</head>
	<body>
		<a class="salta" href="#contenuto">Vai al contenuto</a>
		<header class="testata">
			<div class="contenitore">
				<p class="etichetta"><span class="punto" aria-hidden="true"></span> Serata {d.serataAttuale}/5 · Round {d.roundAttuale}/10</p>
				<h1>{d.nomeLega}</h1>
				<p class="sottotitolo">Reality Fracture · Sealed League</p>
				<div class="avanzamento" role="img" aria-label={`Round ${d.roundAttuale} di 10`}>
					{Array.from({ length: 10 }, (_, i) => (
						<span class:list={['tacca', { fatta: i < d.roundAttuale, finale: i >= 8 }]}></span>
					))}
				</div>
			</div>
		</header>

		<main id="contenuto" class="contenitore">
			<section aria-labelledby="titolo-classifica">
				<h2 id="titolo-classifica">Classifica</h2>

				<table class="classifica">
					<caption class="solo-lettori">Classifica della lega, dal primo all'ultimo</caption>
					<thead>
						<tr>
							<th scope="col">#</th>
							<th scope="col">Giocatore</th>
							<th scope="col" class="num">Punti</th>
							<th scope="col" class="num">V-P-S</th>
							<th scope="col" class="num"><abbr title="Percentuale di match vinti dagli avversari">OMW%</abbr></th>
							<th scope="col" class="num"><abbr title="Percentuale di game vinti">GW%</abbr></th>
							<th scope="col" class="num"><abbr title="Percentuale di game vinti dagli avversari">OGW%</abbr></th>
						</tr>
					</thead>
					<tbody>
						{d.righe.map((r) => (
							<tr>
								<td><span class:list={['badge', `p${Number.parseInt(r.posizione)}`]}>{r.posizione}</span></td>
								<th scope="row">
									{r.nome}
									{r.variazione !== 0 && (
										<span class:list={['freccia', r.variazione > 0 ? 'su' : 'giu']}>
											<span aria-hidden="true">{r.variazione > 0 ? '↑' : '↓'}{Math.abs(r.variazione)}</span>
											<span class="solo-lettori">{r.variazione > 0 ? 'sale' : 'scende'} di {Math.abs(r.variazione)}</span>
										</span>
									)}
								</th>
								<td class="num">
									<span class="barra" style={`--quota: ${r.punti / puntiMassimi}`} aria-hidden="true"></span>
									<strong class="punti">{r.punti}</strong>
								</td>
								<td class="num">{r.record}</td>
								<td class="num tenue">{r.omw}</td>
								<td class="num tenue">{r.gw}</td>
								<td class="num tenue">{r.ogw}</td>
							</tr>
						))}
					</tbody>
				</table>

				<ol class="classifica-schede">
					{d.righe.map((r) => (
						<li class="scheda">
							<span class:list={['badge', `p${Number.parseInt(r.posizione)}`]} aria-label={`Posizione ${r.posizione}`}>{r.posizione}</span>
							<span class="chi">
								<strong>{r.nome}</strong>
								<span class="dettagli">{r.record} · OMW {r.omw}</span>
								<span class="barra" style={`--quota: ${r.punti / puntiMassimi}`} aria-hidden="true"></span>
							</span>
							<span class="punti"><strong>{r.punti}</strong><small>pt</small></span>
						</li>
					))}
				</ol>
			</section>

			<section aria-labelledby="titolo-match" class:list={['match', { finale: d.finale }]}>
				<h2 id="titolo-match">
					{d.finale ? 'Finale' : 'Prossimi match'}
					{d.finale && <span class="moltiplicatore">×{d.moltiplicatore} punti</span>}
				</h2>
				<ul class="partite">
					{d.partite.map((p, i) => (
						<li class="partita">
							<span class="tavolo">T{i + 1}</span>
							<span class:list={['giocatore', { vince: p.vincitore === 'a', perde: p.vincitore === 'b' }]}>{p.a}</span>
							<span class="risultato">{p.risultato ?? 'VS'}</span>
							<span class:list={['giocatore', 'destra', { vince: p.vincitore === 'b', perde: p.vincitore === 'a' }]}>{p.b}</span>
						</li>
					))}
				</ul>
				{d.bye && <p class="nota">Bye: {d.bye}</p>}
			</section>

			<section aria-labelledby="titolo-pool">
				<h2 id="titolo-pool">Pool · {d.pool.nome}</h2>
				<p class="nota">{d.pool.totaleCarte} carte · le più rare</p>
				<ul class="carte">
					{d.pool.carte.map((c) => (
						<li class:list={['carta', c.rarita]}>
							<img src={c.immagine} alt={c.nome} loading="lazy" width="244" height="340" />
							<span class="carta-info">
								<span class="colori">
									{c.colori.map((col) => (
										<span class:list={['mana', col]} title={nomiColori[col]}>
											<span class="solo-lettori">{nomiColori[col]}</span>
										</span>
									))}
								</span>
								<span class="rarita">{nomiRarita[c.rarita]}</span>
								{c.copie > 1 && <span class="copie">×{c.copie}</span>}
							</span>
						</li>
					))}
				</ul>
			</section>
		</main>

		<footer class="contenitore">
			<p>Pagina di prova dello <strong>stile B – Arena</strong>. Dati fittizi.</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--sfondo: #0e1117;
		--superficie: #171b24;
		--superficie-alta: #1f2531;
		--testo: #e9edf4;
		--testo-tenue: #9aa4b5;
		--bordo: #2a3140;
		--accento: #8b7cff;
		--accento-2: #3ad6c5;
		--oro: #f2c14e;
		--argento: #c3cbd8;
		--bronzo: #d4895a;
		--vittoria: #4ade80;
		--sconfitta: #f87171;
		--sans: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		color-scheme: dark;
	}
	* { box-sizing: border-box; }
	body {
		margin: 0;
		background: var(--sfondo);
		color: var(--testo);
		font-family: var(--sans);
		line-height: 1.5;
	}
	.contenitore { max-width: 60rem; margin: 0 auto; padding: 0 1rem; }
	.salta { position: absolute; left: -999px; }
	.salta:focus { left: 1rem; top: 1rem; background: var(--accento); color: #000; padding: .5rem 1rem; z-index: 1; }
	.solo-lettori {
		position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
	}

	.testata {
		padding: 2.5rem 0 2rem;
		background:
			radial-gradient(60rem 20rem at 10% -20%, rgba(139, 124, 255, .35), transparent 70%),
			radial-gradient(40rem 18rem at 100% 0%, rgba(58, 214, 197, .2), transparent 70%);
		border-bottom: 1px solid var(--bordo);
	}
	.etichetta {
		display: inline-flex; align-items: center; gap: .5rem; margin: 0;
		font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
		background: var(--superficie-alta); border: 1px solid var(--bordo); padding: .3rem .75rem; border-radius: 999px;
	}
	.punto { width: .5rem; height: .5rem; border-radius: 50%; background: var(--accento-2); box-shadow: 0 0 8px var(--accento-2); }
	h1 { margin: .75rem 0 0; font-size: clamp(2rem, 8vw, 3.5rem); font-weight: 800; letter-spacing: -.03em; line-height: 1.05; }
	.sottotitolo { margin: .25rem 0 1.25rem; color: var(--testo-tenue); }
	.avanzamento { display: grid; grid-template-columns: repeat(10, 1fr); gap: 4px; max-width: 24rem; }
	.tacca { height: 6px; border-radius: 3px; background: var(--superficie-alta); }
	.tacca.fatta { background: linear-gradient(90deg, var(--accento), var(--accento-2)); }
	.tacca.finale.fatta { background: var(--oro); }

	section { margin: 2.5rem 0; }
	h2 {
		margin: 0 0 1rem; font-size: 1.1rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
		color: var(--testo-tenue); display: flex; align-items: center; gap: .75rem; flex-wrap: wrap;
	}
	.nota { margin: -.5rem 0 1rem; color: var(--testo-tenue); font-size: .9rem; }

	/* Classifica: tabella */
	.classifica {
		width: 100%; border-collapse: separate; border-spacing: 0; font-variant-numeric: tabular-nums;
		background: var(--superficie); border: 1px solid var(--bordo); border-radius: 12px; overflow: hidden;
	}
	.classifica th, .classifica td { padding: .7rem .75rem; text-align: left; border-bottom: 1px solid var(--bordo); }
	.classifica tbody tr:last-child > * { border-bottom: 0; }
	.classifica thead th { font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--testo-tenue); font-weight: 600; background: var(--superficie-alta); }
	.classifica tbody th { font-weight: 600; }
	.classifica tbody tr:hover { background: var(--superficie-alta); }
	.classifica .num { text-align: right; }
	.classifica .tenue { color: var(--testo-tenue); }
	.classifica .barra { display: inline-block; vertical-align: middle; margin-right: .6rem; width: 4rem; }
	.punti { font-size: 1.1rem; }
	abbr { text-decoration: none; cursor: help; }
	.freccia { font-size: .75rem; font-weight: 700; margin-left: .5rem; }
	.freccia.su { color: var(--vittoria); }
	.freccia.giu { color: var(--sconfitta); }
	.barra {
		display: block; height: 4px; border-radius: 2px; background: var(--superficie-alta); position: relative; overflow: hidden;
	}
	.barra::after {
		content: ''; position: absolute; inset: 0; width: calc(var(--quota) * 100%);
		background: linear-gradient(90deg, var(--accento), var(--accento-2));
	}

	.badge {
		display: inline-grid; place-items: center; min-width: 2rem; height: 2rem; padding: 0 .4rem; border-radius: 8px;
		background: var(--superficie-alta); font-weight: 800; font-variant-numeric: tabular-nums;
	}
	.badge.p1 { background: var(--oro); color: #1a1405; }
	.badge.p2 { background: var(--argento); color: #12161d; }
	.badge.p3 { background: var(--bronzo); color: #1d0f06; }

	/* Classifica: schede su telefono */
	.classifica-schede { display: none; list-style: none; padding: 0; margin: 0; gap: .5rem; }
	.scheda {
		display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .9rem;
		background: var(--superficie); border: 1px solid var(--bordo); border-radius: 12px; padding: .8rem 1rem;
	}
	.scheda .chi { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
	.scheda .dettagli { font-size: .8rem; color: var(--testo-tenue); font-variant-numeric: tabular-nums; }
	.scheda .punti { text-align: right; line-height: 1; }
	.scheda .punti strong { font-size: 1.6rem; display: block; }
	.scheda .punti small { color: var(--testo-tenue); font-size: .7rem; text-transform: uppercase; letter-spacing: .1em; }
	@media (max-width: 40rem) {
		.classifica { display: none; }
		.classifica-schede { display: grid; }
	}

	/* Match */
	.moltiplicatore {
		color: #1a1405; background: var(--oro); padding: .15rem .6rem; border-radius: 6px; font-size: .8rem; letter-spacing: .05em;
	}
	.partite { list-style: none; padding: 0; margin: 0; display: grid; gap: .5rem; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); }
	.partita {
		display: grid; grid-template-columns: auto 1fr auto 1fr; align-items: center; gap: .75rem;
		background: var(--superficie); border: 1px solid var(--bordo); border-radius: 12px; padding: .9rem 1rem;
	}
	.match.finale .partita {
		border-color: transparent;
		background:
			linear-gradient(var(--superficie), var(--superficie)) padding-box,
			linear-gradient(120deg, var(--oro), #b8862b 40%, var(--accento)) border-box;
		box-shadow: 0 0 24px rgba(242, 193, 78, .12);
	}
	.tavolo { font-size: .7rem; font-weight: 700; color: var(--testo-tenue); background: var(--superficie-alta); padding: .15rem .4rem; border-radius: 4px; }
	.giocatore { font-weight: 600; }
	.giocatore.destra { text-align: right; }
	.giocatore.vince { color: var(--vittoria); }
	.giocatore.perde { color: var(--testo-tenue); font-weight: 400; }
	.risultato { font-weight: 800; font-variant-numeric: tabular-nums; font-size: 1.1rem; }

	/* Pool */
	.carte { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); gap: 1rem; }
	.carta img {
		width: 100%; height: auto; display: block; border-radius: 4.5% / 3.5%;
		transition: transform .2s; box-shadow: 0 6px 16px rgba(0, 0, 0, .5);
	}
	.carta.mythic img { box-shadow: 0 0 0 2px #e8642c, 0 6px 20px rgba(232, 100, 44, .35); }
	.carta.rare img { box-shadow: 0 0 0 2px var(--oro), 0 6px 20px rgba(242, 193, 78, .25); }
	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.carta img:hover { transform: translateY(-4px) scale(1.02); }
	}
	.carta-info { display: flex; align-items: center; gap: .4rem; margin-top: .5rem; font-size: .75rem; color: var(--testo-tenue); }
	.copie { margin-left: auto; font-weight: 700; color: var(--testo); }
	.colori { display: inline-flex; gap: 3px; }
	.mana { width: .75rem; height: .75rem; border-radius: 50%; display: inline-block; }
	.mana.W { background: #f6eecb; } .mana.U { background: #4a9be8; } .mana.B { background: #a48fb3; }
	.mana.R { background: #ef5a3c; } .mana.G { background: #3fb46a; }

	footer { color: var(--testo-tenue); font-size: .85rem; padding: 2rem 1rem; border-top: 1px solid var(--bordo); }
</style>
