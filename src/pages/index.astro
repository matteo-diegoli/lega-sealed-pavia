---
// Pagina provvisoria (Fase 3): vetrina dello stile "Arena" nei due temi.
// Nella Fase 4 diventerà la classifica.
import Base from '../layouts/Base.astro';
import SkylinePavia from '../components/SkylinePavia.astro';

const colori = [
	['--sfondo', 'Sfondo'],
	['--superficie', 'Superficie'],
	['--superficie-alta', 'Superficie alta'],
	['--testo', 'Testo'],
	['--testo-tenue', 'Testo tenue'],
	['--accento', 'Accento'],
	['--accento-2', 'Accento 2'],
	['--oro', 'Oro (finale)'],
	['--vittoria', 'Vittoria'],
	['--sconfitta', 'Sconfitta'],
];
const mana = [
	['W', 'Bianco'],
	['U', 'Blu'],
	['B', 'Nero'],
	['R', 'Rosso'],
	['G', 'Verde'],
];
---

<Base titolo="Lega Sealed Pavia">
	<section class="eroe">
		<div class="contenitore">
			<p class="etichetta"><span class="punto" aria-hidden="true"></span> Serata 5/5 · Round 10/10</p>
			<h1>Lega Sealed Pavia</h1>
			<p class="sottotitolo">Reality Fracture · Sealed League</p>
			<div class="avanzamento" role="img" aria-label="Round 10 di 10">
				{Array.from({ length: 10 }, (_, i) => <span class:list={['tacca', 'fatta', { finale: i >= 8 }]}></span>)}
			</div>
		</div>
		<SkylinePavia class="eroe-skyline" />
	</section>

	<div class="contenitore">
		<p class="avviso">
			Pagina di prova dello stile: la classifica vera arriva nella Fase 4. Prova il pulsante in alto a destra per
			cambiare tema.
		</p>

		<section aria-labelledby="titolo-colori">
			<h2 id="titolo-colori" class="titolo-sezione">Colori</h2>
			<ul class="colori">
				{colori.map(([variabile, nome]) => (
					<li class="scheda colore">
						<span class="campione" style={`background: var(${variabile})`}></span>
						<span>{nome}</span>
						<code>{variabile}</code>
					</li>
				))}
			</ul>
			<p class="riga-mana">
				{mana.map(([sigla, nome]) => (
					<span class="voce-mana"><span class:list={['mana', sigla]}></span> {nome}</span>
				))}
			</p>
		</section>

		<section aria-labelledby="titolo-schede">
			<h2 id="titolo-schede" class="titolo-sezione">Schede</h2>
			<ol class="esempi-classifica">
				<li class="scheda riga-classifica">
					<span class="badge oro" aria-label="Posizione 1">1</span>
					<span class="chi"><strong>Anna Bianchi</strong><span class="dettagli">7-1-2 · OMW 58,3%</span></span>
					<span class="punti"><strong>25</strong><small>pt</small></span>
				</li>
				<li class="scheda riga-classifica">
					<span class="badge argento" aria-label="Posizione 2">2</span>
					<span class="chi"><strong>Carla Rossi</strong><span class="dettagli">7-0-3 · OMW 55,0%</span></span>
					<span class="punti"><strong>24</strong><small>pt</small></span>
				</li>
				<li class="scheda riga-classifica">
					<span class="badge bronzo" aria-label="Posizione 3">3</span>
					<span class="chi"><strong>Bruno Verdi</strong><span class="dettagli">6-1-3 · OMW 52,1%</span></span>
					<span class="punti"><strong>21</strong><small>pt</small></span>
				</li>
			</ol>
			<div class="scheda partita finale">
				<span class="tavolo">T1</span>
				<span class="giocatore vince">Anna Bianchi</span>
				<span class="risultato">2-1</span>
				<span class="giocatore destra perde">Giulia Neri</span>
			</div>
		</section>

		<section aria-labelledby="titolo-pulsanti">
			<h2 id="titolo-pulsanti" class="titolo-sezione">Pulsanti</h2>
			<p class="pulsanti">
				<a class="pulsante principale" href="#contenuto">Vedi la classifica</a>
				<a class="pulsante" href="#contenuto">Prossimi match</a>
			</p>
		</section>
	</div>
</Base>

<style>
	.eroe {
		background: var(--sfondo-testata);
		border-bottom: 1px solid var(--bordo);
		padding-top: 2.5rem;
		overflow: hidden;
	}
	.etichetta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		background: var(--superficie-alta);
		border: 1px solid var(--bordo);
		padding: 0.3rem 0.75rem;
		border-radius: 999px;
	}
	.punto {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--accento-2);
		box-shadow: 0 0 8px var(--accento-2);
	}
	h1 {
		margin: 0.75rem 0 0;
		font-size: clamp(2rem, 8vw, 3.5rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}
	.sottotitolo {
		margin: 0.25rem 0 1.25rem;
		color: var(--testo-tenue);
	}
	.avanzamento {
		display: grid;
		grid-template-columns: repeat(10, 1fr);
		gap: 4px;
		max-width: 24rem;
	}
	.tacca {
		height: 6px;
		border-radius: 3px;
		background: var(--superficie-alta);
	}
	.tacca.fatta {
		background: var(--sfumatura);
	}
	.tacca.finale.fatta {
		background: var(--oro);
	}
	.eroe :global(.eroe-skyline) {
		margin-top: 1rem;
		min-height: 120px;
	}

	.avviso {
		margin: 2rem 0;
		padding: 0.75rem 1rem;
		border-left: 4px solid var(--accento);
		background: var(--superficie);
		border-radius: var(--raggio-piccolo);
		color: var(--testo-tenue);
	}
	section:not(.eroe) {
		margin: 2.5rem 0;
	}

	.colori {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
		gap: 0.5rem;
	}
	.colore {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.6rem;
		font-size: 0.85rem;
	}
	.campione {
		height: 2.5rem;
		border-radius: var(--raggio-piccolo);
		border: 1px solid var(--bordo);
	}
	code {
		color: var(--testo-tenue);
		font-size: 0.75rem;
	}
	.riga-mana {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 1rem;
	}
	.voce-mana {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.esempi-classifica {
		list-style: none;
		padding: 0;
		margin: 0 0 1rem;
		display: grid;
		gap: 0.5rem;
	}
	.riga-classifica {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 0.9rem;
	}
	.chi {
		display: flex;
		flex-direction: column;
	}
	.dettagli {
		font-size: 0.8rem;
		color: var(--testo-tenue);
	}
	.punti {
		text-align: right;
		line-height: 1;
	}
	.punti strong {
		display: block;
		font-size: 1.6rem;
	}
	.punti small {
		color: var(--testo-tenue);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.partita {
		display: grid;
		grid-template-columns: auto 1fr auto 1fr;
		align-items: center;
		gap: 0.75rem;
	}
	.partita.finale {
		border-color: transparent;
		background:
			linear-gradient(var(--superficie), var(--superficie)) padding-box,
			linear-gradient(120deg, var(--oro), #b8862b 40%, var(--accento)) border-box;
	}
	.tavolo {
		font-size: 0.7rem;
		font-weight: 700;
		color: var(--testo-tenue);
		background: var(--superficie-alta);
		padding: 0.15rem 0.4rem;
		border-radius: 4px;
	}
	.giocatore {
		font-weight: 600;
	}
	.destra {
		text-align: right;
	}
	.vince {
		color: var(--vittoria);
	}
	.perde {
		color: var(--testo-tenue);
		font-weight: 400;
	}
	.risultato {
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		font-size: 1.1rem;
	}
	.pulsanti {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
</style>
