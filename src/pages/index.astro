---
// Home: a che punto è la lega, classifica attuale, busta extra, finale ×2 ed evoluzione serata per serata.
// Tutto viene calcolato quando si crea il sito: nel browser non gira nessun calcolo.
import Base from '../layouts/Base.astro';
import SkylinePavia from '../components/SkylinePavia.astro';
import BarraRound from '../components/BarraRound.astro';
import Classifica from '../components/Classifica.astro';
import { caricaDati } from '../lib/dati/carica.ts';
import { NUMERO_SERATE } from '../lib/dati/schema.ts';
import { busteDellaSerata } from '../lib/lega/buste.ts';
import {
	NUMERO_ROUND,
	classificaAttuale,
	evoluzione,
	formattaData,
	puntiInFinale,
	statoLega,
} from '../lib/lega/riepilogo.ts';
import { anteprimaClassifica } from '../lib/sito/anteprime.ts';
import { datiStrutturatiLega } from '../lib/sito/dati-strutturati.ts';
import { percorso } from '../lib/sito/percorso.ts';

const dati = caricaDati();
const anteprima = anteprimaClassifica(dati);
const stato = statoLega(dati);
const attuale = classificaAttuale(dati);
const tappe = evoluzione(dati);
const nomeDi = (id: string) => dati.giocatori.find((g) => g.id === id)?.nome ?? id;
const dataDi = (serata: number) => dati.lega.serate.find((s) => s.numero === serata)?.data ?? null;

// I punti della finale si mostrano in oro appena ce n'è almeno uno.
const roundFinale = NUMERO_ROUND - 1;
const puntiFinale = attuale.classifica.finoAlRound >= roundFinale ? puntiInFinale(dati) : undefined;

// Testata: a che punto siamo.
const dataSerata = dataDi(stato.serata);
const etichetta = stato.finita
	? 'Lega conclusa'
	: stato.roundInCorso
		? `Serata ${stato.serata}/${NUMERO_SERATE} · Round ${stato.roundInCorso}/${NUMERO_ROUND} in corso`
		: `${stato.roundGiocati === 0 ? 'Si parte' : 'Prossima'}: serata ${stato.serata}/${NUMERO_SERATE}` +
			(dataSerata ? ` · ${formattaData(dataSerata)}` : '');
const vincitore = stato.finita ? attuale.classifica.righe[0] : undefined;

// Busta extra della serata in corso o della prossima (non c'è alla serata 1).
const buste = !stato.finita && stato.serata > 1 ? busteDellaSerata(dati, stato.serata) : null;

const sottotitoloClassifica =
	attuale.classifica.finoAlRound === 0
		? 'Nessun round giocato: si comincia alla serata 1.'
		: `Dopo il round ${attuale.classifica.finoAlRound} di ${NUMERO_ROUND}` +
			(attuale.rispettoAllaSerata ? ` · frecce rispetto alla fine della serata ${attuale.rispettoAllaSerata}` : '');
---

<Base
	titolo={dati.lega.nome}
	titoloAnteprima={anteprima.titolo}
	descrizione={anteprima.descrizione}
	jsonLd={datiStrutturatiLega(dati, new URL(percorso(), Astro.site).href)}
>
	<section class="eroe">
		<div class="contenitore">
			<p class="etichetta"><span class="punto" aria-hidden="true"></span> {etichetta}</p>
			<h1>{dati.lega.nome}</h1>
			<p class="sottotitolo">Reality Fracture · Sealed League · {dati.giocatori.length} giocatori</p>
			<BarraRound stato={stato} />
		</div>
		<SkylinePavia class="eroe-skyline" />
	</section>

	<div class="contenitore">
		<section aria-labelledby="titolo-classifica">
			<h2 id="titolo-classifica" class="titolo-sezione">Classifica</h2>
			<p class="nota">{sottotitoloClassifica}</p>
			<Classifica
				classifica={attuale.classifica}
				variazioni={attuale.variazioni}
				puntiFinale={puntiFinale}
				didascalia="Classifica attuale"
			/>
			<details class="legenda">
				<summary>Come si legge la classifica</summary>
				<dl>
					<dt>Punti</dt>
					<dd>
						Vittoria 3, pareggio 1, sconfitta 0, contati sui <strong>match</strong> (BO3). Il bye vale come una
						vittoria 2-0. In finale i punti valgono doppio, ma solo nella colonna Punti: negli spareggi qui sotto
						contano normali.
					</dd>
					<dt>V-P-S</dt>
					<dd><strong>Match</strong> vinti, pareggiati e persi (bye compresi).</dd>
					<dt>Spareggi</dt>
					<dd>A parità di punti decide OMW%, poi GW%, poi OGW%.</dd>
					<dt>OMW%</dt>
					<dd>
						Si contano i <strong>match</strong>: media delle percentuali di vittoria (MW%) degli avversari affrontati.
						<span class="formula">MW% = punti nei match ÷ (3 × match giocati)</span>
						<span class="formula">OMW% = media degli MW% degli avversari, ognuno almeno 33%</span>
						Il bye conta per il proprio MW% ma non come avversario; un avversario incontrato due volte conta due volte.
					</dd>
					<dt>GW%</dt>
					<dd>
						Si contano i <strong>game</strong>: la propria percentuale di game vinti.
						<span class="formula">GW% = (3 × game vinti + 1 × game pareggiati) ÷ (3 × game giocati)</span>
						Es. chi vince 2-1 fa 2 game vinti su 3. Il bye vale 2 game vinti.
					</dd>
					<dt>OGW%</dt>
					<dd>
						Si contano i <strong>game</strong>: media dei GW% degli avversari affrontati, ognuno almeno 33%.
					</dd>
					<dt>Pari merito</dt>
					<dd>
						Stessi punti, OMW%, GW% e OGW%. Tra loro decide lo scontro diretto (con più di due giocatori, i punti fatti
						negli scontri tra loro), poi un sorteggio fisso, sempre uguale.
					</dd>
				</dl>
			</details>
		</section>

		{
			(vincitore || buste || !stato.finita) && (
				<div class="avvisi">
					{vincitore && (
						<p class="scheda avviso campione">
							<span class="icona" aria-hidden="true">🏆</span>
							<span>
								Vince la lega <strong>{vincitore.nome}</strong> con {vincitore.punti} punti.
							</span>
						</p>
					)}
					{!stato.finita && (
						<p class="scheda avviso finale">
							<span class="icona" aria-hidden="true">×2</span>
							<span>
								<strong>La finale vale doppio.</strong> Nei round 9 e 10 (serata {NUMERO_SERATE}) la vittoria vale 6
								punti e il pareggio 2.
							</span>
						</p>
					)}
					{buste && (buste.extra || buste.avviso) && (
						<p class="scheda avviso">
							<span class="icona" aria-hidden="true">🎁</span>
							<span>
								{buste.extra ? (
									<>
										Alla serata {buste.serata} la <strong>busta extra</strong> va a <strong>{nomeDi(buste.extra)}</strong>,
										ultimo in classifica tra i presenti.
									</>
								) : (
									buste.avviso
								)}
							</span>
						</p>
					)}
				</div>
			)
		}

		{
			tappe.length > 1 && (
				<section aria-labelledby="titolo-evoluzione">
					<h2 id="titolo-evoluzione" class="titolo-sezione">Serata per serata</h2>
					<p class="nota">La classifica al termine di ogni serata, con le frecce rispetto alla serata prima.</p>
					{tappe.map((tappa) => {
						const data = dataDi(tappa.serata);
						const primo = tappa.classifica.righe[0];
						return (
							<details class="tappa">
								<summary>
									<span class="numero-serata">Serata {tappa.serata}</span>
									{data && <span class="data">{formattaData(data)}</span>}
									{primo && <span class="testa">in testa: {primo.nome}</span>}
								</summary>
								<Classifica
									classifica={tappa.classifica}
									variazioni={tappa.variazioni}
									puntiFinale={tappa.serata === NUMERO_SERATE ? puntiInFinale(dati) : undefined}
									didascalia={`Classifica al termine della serata ${tappa.serata}`}
								/>
							</details>
						);
					})}
				</section>
			)
		}
	</div>
</Base>

<style>
	.eroe {
		background: var(--sfondo-testata);
		border-bottom: 1px solid var(--bordo);
		padding-top: 1rem;
		overflow: hidden;
	}
	.etichetta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		background: var(--superficie-alta);
		border: 1px solid var(--bordo);
		padding: 0.3rem 0.75rem;
		border-radius: 999px;
	}
	.punto {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--accento-2);
		box-shadow: 0 0 8px var(--accento-2);
	}
	h1 {
		margin: 0.75rem 0 0;
		font-size: clamp(2rem, 8vw, 3.5rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}
	.sottotitolo {
		margin: 0.25rem 0 1.25rem;
		color: var(--testo-tenue);
	}
	.eroe :global(.eroe-skyline) {
		margin-top: 1rem;
		min-height: 120px;
	}

	section:not(.eroe) {
		margin: 2.5rem 0;
	}
	/* La classifica arriva subito dopo la testata */
	.contenitore > section:first-child {
		margin-top: 2rem;
	}
	.nota {
		margin: -0.5rem 0 1rem;
		font-size: 0.85rem;
		color: var(--testo-tenue);
	}

	/* Avvisi sotto la classifica */
	.avvisi {
		display: grid;
		gap: 0.75rem;
	}
	@media (min-width: 44rem) {
		.avvisi {
			grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		}
	}
	.avviso {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		margin: 0;
		font-size: 0.95rem;
	}
	.icona {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		background: var(--superficie-alta);
		font-size: 1.2rem;
		font-weight: 800;
	}
	.avviso.finale,
	.avviso.campione {
		border-color: transparent;
		background:
			linear-gradient(var(--superficie), var(--superficie)) padding-box,
			linear-gradient(120deg, var(--oro), #b8862b 40%, var(--accento)) border-box;
	}
	.avviso.finale .icona,
	.avviso.campione .icona {
		background: var(--oro);
		color: var(--su-medaglia);
	}

	/* Parti richiudibili */
	details {
		margin-top: 0.75rem;
	}
	summary {
		cursor: pointer;
		min-height: 2.75rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.75rem;
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	/* Freccetta che ruota quando il pannello è aperto */
	summary::before {
		content: '▸';
		transition: rotate 0.15s;
	}
	details[open] > summary::before {
		rotate: 90deg;
	}
	.legenda summary {
		color: var(--accento);
		font-weight: 600;
	}
	.legenda dl {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.4rem 1rem;
		margin: 0.5rem 0 0;
		font-size: 0.9rem;
	}
	.legenda dt {
		font-weight: 700;
	}
	.legenda dd {
		margin: 0;
		color: var(--testo-tenue);
	}
	.legenda strong {
		color: var(--testo);
	}
	/* Formula su una riga a parte, in carattere monospaziato */
	.legenda .formula {
		display: block;
		margin: 0.3rem 0;
		font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace;
		font-size: 0.8rem;
		color: var(--testo);
		overflow-wrap: anywhere;
	}
	.tappa {
		background: var(--superficie);
		border: 1px solid var(--bordo);
		border-radius: var(--raggio);
		padding: 0 1rem;
	}
	.tappa[open] {
		padding-bottom: 1rem;
	}
	.tappa[open] summary {
		margin-bottom: 0.5rem;
	}
	.numero-serata {
		font-weight: 800;
	}
	.data,
	.testa {
		font-size: 0.85rem;
		color: var(--testo-tenue);
	}
	.testa {
		margin-left: auto;
	}
</style>
